{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caniko/android-manager/schemas/plan-v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "configDigest", "lockDigest", "deviceBinding", "snapshotDigest", "changes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource", "kind", "summary", "operation", "risk", "policy"],
        "properties": {
          "resource": {"type": "string"},
          "kind": {"type": "string"},
          "summary": {"type": "string"},
          "dependsOn": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
