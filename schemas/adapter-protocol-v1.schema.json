{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caniko/android-manager/schemas/adapter-protocol-v1.schema.json",
  "$defs": {
    "capability": {
      "enum": ["resolve", "planDelegate"]
    },
    "identity": {
      "type": "object",
      "required": ["id", "kind", "capabilities"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["source", "delegate"]},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["protocolVersion", "requestId", "method", "params"],
      "properties": {
        "protocolVersion": {"const": 1},
        "requestId": {"type": "string", "minLength": 1},
        "method": {"enum": ["handshake", "capabilities", "resolve", "planDelegate"]},
        "params": {"type": "object"}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["protocolVersion", "requestId"],
      "properties": {
        "protocolVersion": {"const": 1},
        "requestId": {"type": "string", "minLength": 1},
        "method": {"enum": ["handshake", "capabilities", "resolve", "planDelegate"]},
        "result": {},
        "error": {"$ref": "#/$defs/error"}
      },
      "oneOf": [
        {"required": ["result"], "not": {"required": ["error"]}},
        {"required": ["error"], "not": {"required": ["result"]}}
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"}
  ]
}
